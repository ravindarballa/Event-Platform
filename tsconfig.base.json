{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      // Frontend remotes
      "photography/Module": ["apps/photography/src/remote-entry.ts"],
      "hallbooking/Module": ["apps/hallbooking/src/remote-entry.ts"],

      // Shared libraries
      "@event-platform/shared-ui": ["libs/shared-ui/src/index.ts"],

      // Hall feature libraries
      "@event-platform/api-hall-data-access": ["libs/api/hall/hallbooking-data-access/src/index.ts"],
      "@event-platform/api-hall-feature": ["libs/api/hall/feature/src/index.ts"],

      // Photography feature libraries
      "@event-platform/photography-feature-gallery": ["libs/photography/feature-gallery/src/index.ts"],
      "@event-platform/api-photo-data-access": ["libs/api/photography/photo-data-access/src/index.ts"],
      "@event-platform/api-photography-feature": ["libs/api/photography/feature/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
