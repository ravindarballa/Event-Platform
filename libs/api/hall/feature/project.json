{
  "name": "api-hall-feature",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/hall/feature/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api/hall/feature",
        "tsConfig": "libs/api/hall/feature/tsconfig.lib.json",
        "packageJson": "libs/api/hall/feature/package.json",
        "main": "libs/api/hall/feature/src/index.ts",
        "assets": ["libs/api/hall/feature/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/api/hall/feature/jest.config.cts"
      }
    }
  }
}
